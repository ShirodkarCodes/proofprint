# ── Backblaze B2 ────────────────────────────────────────────────────────────
# Create the bucket with OBJECT LOCK ENABLED — it cannot be turned on later.
# App key: https://secure.backblaze.com/app_keys.htm (Read+Write, scoped to the bucket)
B2_BUCKET=your-bucket-name
B2_KEY_ID=your-key-id
B2_APP_KEY=your-application-key
B2_REGION=us-west-004

# Object Lock retention in days (GOVERNANCE mode). Set to 0 to disable —
# required if your bucket was created without Object Lock.
B2_OBJECT_LOCK_DAYS=1
B2_PREFIX=proofprint

# ── Generative providers (at least one) ─────────────────────────────────────
# NVIDIA NIM — free credits, no card: https://build.nvidia.com
# Serves the open-weight image models (FLUX.1, Stable Diffusion 3.5, SDXL).
NVIDIA_API_KEY=nvapi-...

# Google AI Studio — free tier: https://aistudio.google.com/apikey
# Used for prompt expansion (chat) and as the cross-provider image failover.
GEMINI_API_KEY=...

# ── App ─────────────────────────────────────────────────────────────────────
PROOFPRINT_TENANT=public-demo
PROOFPRINT_WORK_DIR=/tmp/proofprint
PROOFPRINT_STEP_TIMEOUT=240
